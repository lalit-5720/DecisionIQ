# Copy to .env (docker compose reads it automatically). Every value is optional.

# Secret used to sign login tokens. Leave empty to have one generated and kept in data/.jwt_secret.
DIQ_JWT_SECRET=

# Shared password of the three demo accounts (Admin / Manager / Analyst), set when the users table is first created.
# CHANGE THIS before exposing the app beyond your own machine.
DIQ_DEMO_PASSWORD=DecisionIQ@2026

# false hides the demo role tabs on the login page
DIQ_DEMO_MODE=true
